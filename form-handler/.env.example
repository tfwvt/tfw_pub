# Copy to .env (never commit the real one) and fill in.

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hostname(s) this handler is served from, comma-separated
DJANGO_ALLOWED_HOSTS=forms.example.com

# Web page origin(s) allowed to post the form (scheme + host, no trailing slash)
CORS_ALLOWED_ORIGINS=https://tfish.net,https://www.tfish.net

# Where enquiries are delivered
CONTACT_TO_EMAIL=tfishapps@gmail.com

# Gmail SMTP: use an App Password (Google Account > Security > App passwords),
# not your normal password. 2-Step Verification must be on.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=tfishapps@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Triggerfish Website <tfishapps@gmail.com>

# Max messages per visitor IP per hour
RATE_LIMIT_PER_HOUR=5

# Set to 1 when running behind a reverse proxy / load balancer (Render, Heroku, nginx...)
BEHIND_PROXY=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Local development only: prints emails to the terminal when EMAIL_HOST_USER is empty
# DJANGO_DEBUG=1
